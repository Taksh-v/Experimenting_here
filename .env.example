# Server-only credentials. Never expose these with NEXT_PUBLIC_ prefixes.
LLAMA_CLOUD_API_KEY=
# Optional LlamaParse v2 settings; defaults prioritize resume extraction accuracy.
LLAMAPARSE_TIER=agentic
LLAMAPARSE_VERSION=latest
GROQ_API_KEY=
# Required. Use an exact model ID currently listed for your Groq account.
GROQ_MODEL=
JOB_TOKEN_SECRET=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Vercel may inject KV_REST_API_URL and KV_REST_API_TOKEN instead;
# the application accepts either pair.
RATE_LIMIT_SALT=
# Keep false while experimenting; set true to enforce the limits below.
RATE_LIMIT_ENABLED=false
BETA_DAILY_RESUME_LIMIT=25
BETA_DAILY_IP_RESUME_LIMIT=10
BETA_DAILY_GROQ_LIMIT=200
BETA_DAILY_IP_GROQ_LIMIT=24
BETA_SESSION_GROQ_LIMIT=8
